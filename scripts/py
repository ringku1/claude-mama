#!/usr/bin/env bash
# Run a mama script with the first Python 3.8+ found — python3, python, then `py -3`.
# Windows (Git Bash) often has no python3, or only the Microsoft Store stub, which is skipped.
#   bash scripts/py scripts/log.py <args...>      exit code is the script's own
ok='import sys; sys.exit(sys.version_info < (3, 8))'
for cand in python3 python "py -3"; do
  exe=${cand%% *}
  path=$(command -v "$exe" 2>/dev/null) || continue
  case "$path" in *[Ww]indows[Aa]pps*) continue ;; esac
  # shellcheck disable=SC2086
  if $cand -c "$ok" >/dev/null 2>&1; then
    # shellcheck disable=SC2086
    exec $cand "$@"
  fi
done
echo "mama: needs Python 3.8+ (python3, python or py -3) on PATH" >&2
exit 127
